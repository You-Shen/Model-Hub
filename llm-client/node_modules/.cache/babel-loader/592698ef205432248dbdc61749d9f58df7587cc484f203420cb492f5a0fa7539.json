{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\naxios.defaults.withCredentials = true;\nimport router from '@/router/index.js';\nexport default {\n  name: 'Login',\n  data() {\n    return {\n      username: '',\n      password: '',\n      message: ''\n    };\n  },\n  methods: {\n    async login() {\n      try {\n        const response = await axios.post('/api/login', {\n          username: this.username,\n          password: this.password\n        }, {\n          withCredentials: true\n        });\n        this.message = response.data.message;\n        if (response.data.role === 'admin') {\n          router.push({\n            name: 'AdminDashboard'\n          });\n        } else {\n          router.push({\n            name: 'UserDashboard'\n          });\n        }\n      } catch (error) {\n        this.message = error.response && error.response.data ? error.response.data.message : '登录失败，请稍后重试。';\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","defaults","withCredentials","router","name","data","username","password","message","methods","login","response","post","role","push","error"],"sources":["src/components/Login.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <!-- 顶部导航栏 -->\r\n    <header class=\"bg-white/90 shadow-sm\">\r\n      <div class=\"container mx-auto px-4 py-3 flex justify-between items-center\">\r\n        <div class=\"flex items-center space-x-2\">\r\n          <i class=\"fas fa-robot text-purple-600 text-xl\"></i>\r\n          <span class=\"font-bold text-gray-800\">ModelHub <span class=\"text-purple-600\">V2</span></span>\r\n          <span class=\"hidden md:inline text-sm text-gray-500 ml-2\">一站式大语言模型访问平台</span>\r\n        </div>\r\n        <div class=\"flex items-center space-x-4\">\r\n          <a href=\"#\" class=\"text-gray-600 hover:text-purple-600 transition\">帮助中心</a>\r\n          <a href=\"#\" class=\"text-gray-600 hover:text-purple-600 transition\">关于我们</a>\r\n        </div>\r\n      </div>\r\n    </header>\r\n\r\n    <!-- 主内容区 -->\r\n    <main class=\"gradient-bg min-h-screen flex items-center justify-center p-4\">\r\n      <div class=\"login-card rounded-2xl overflow-hidden w-full max-w-md\">\r\n        <div class=\"p-8\">\r\n          <!-- 欢迎标题 -->\r\n          <div class=\"text-center mb-8\">\r\n            <h1 class=\"text-3xl font-bold text-gray-800 mb-2\">欢迎回来!</h1>\r\n            <p class=\"text-gray-500\">请登录您的账户继续使用AI服务</p>\r\n          </div>\r\n\r\n          <!-- 登录表单 -->\r\n          <form @submit.prevent=\"login\" class=\"space-y-6\">\r\n            <!-- 用户名输入 -->\r\n            <div>\r\n              <label for=\"username\" class=\"block text-sm font-medium text-gray-700 mb-1\">用户名/邮箱：</label>\r\n              <div class=\"relative\">\r\n                <div class=\"absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none\">\r\n                  <i class=\"fas fa-user text-gray-400\"></i>\r\n                </div>\r\n                <input\r\n                    type=\"text\"\r\n                    id=\"username\"\r\n                    v-model=\"username\"\r\n                    placeholder=\"请输入用户名或邮箱\"\r\n                    class=\"input-field pl-10 w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-purple-500 focus:outline-none transition\"\r\n                    required\r\n                >\r\n              </div>\r\n            </div>\r\n\r\n            <!-- 密码输入 -->\r\n            <div>\r\n              <div class=\"flex justify-between items-center mb-1\">\r\n                <label for=\"password\" class=\"block text-sm font-medium text-gray-700\">密码：</label>\r\n                <!--                <a href=\"#\" class=\"text-sm text-purple-600 hover:text-purple-800 transition\">忘记密码?</a>-->\r\n                <router-link to=\"/retrieve-password\" class=\"text-purple-600 font-medium text-sm hover:text-purple-600 transition\">忘记密码？</router-link>\r\n              </div>\r\n              <div class=\"relative\">\r\n                <div class=\"absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none\">\r\n                  <i class=\"fas fa-lock text-gray-400\"></i>\r\n                </div>\r\n                <input\r\n                    type=\"password\"\r\n                    id=\"password\"\r\n                    v-model=\"password\"\r\n                    placeholder=\"请输入密码\"\r\n                    class=\"input-field pl-10 w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-purple-500 focus:outline-none transition\"\r\n                    required\r\n                >\r\n              </div>\r\n            </div>\r\n\r\n            <!-- 登录按钮 -->\r\n            <button\r\n                type=\"submit\"\r\n                class=\"login-btn w-full bg-gradient-to-r from-purple-600 to-blue-500 text-white py-3 px-4 rounded-lg font-medium hover:from-purple-700 hover:to-blue-600 transition\"\r\n            >\r\n              登录\r\n            </button>\r\n\r\n            <!-- 错误消息 -->\r\n            <div v-if=\"message\" class=\"text-center py-2 px-4 rounded-md bg-red-100 text-red-700\">\r\n              {{ message }}\r\n            </div>\r\n          </form>\r\n\r\n          <!-- 注册链接 -->\r\n          <div class=\"mt-8 text-center text-sm text-gray-500\">\r\n            还没有账号?\r\n            <router-link to=\"/register\" class=\"text-purple-600 font-medium hover:text-purple-800 transition\">立即注册</router-link>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 底部装饰 -->\r\n        <div class=\"bg-gray-50 px-8 py-4 text-center\">\r\n          <p class=\"text-xs text-gray-500\">© 2025 ModelHub V2. 保留所有权利。</p>\r\n        </div>\r\n      </div>\r\n    </main>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\naxios.defaults.withCredentials = true;\r\nimport router from '@/router/index.js';\r\n\r\nexport default {\r\n  name: 'Login',\r\n  data() {\r\n    return {\r\n      username: '',\r\n      password: '',\r\n      message: ''\r\n    };\r\n  },\r\n  methods: {\r\n    async login() {\r\n      try {\r\n        const response = await axios.post('/api/login', {\r\n          username: this.username,\r\n          password: this.password\r\n        }, { withCredentials: true });\r\n        this.message = response.data.message;\r\n        if (response.data.role === 'admin') {\r\n          router.push({ name: 'AdminDashboard' });\r\n        } else {\r\n          router.push({ name: 'UserDashboard' });\r\n        }\r\n      } catch (error) {\r\n        this.message = error.response && error.response.data ? error.response.data.message : '登录失败，请稍后重试。';\r\n      }\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.gradient-bg {\r\n  background: linear-gradient(135deg, #6e8efb 0%, #a777e3 100%);\r\n}\r\n.login-card {\r\n  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);\r\n  backdrop-filter: blur(10px);\r\n  background-color: rgba(255, 255, 255, 0.85);\r\n}\r\n.input-field:focus {\r\n  box-shadow: 0 0 0 3px rgba(167, 119, 227, 0.3);\r\n}\r\n.login-btn {\r\n  transition: all 0.3s ease;\r\n}\r\n.login-btn:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n/* 确保Font Awesome图标正常显示 */\r\n@import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css');\r\n</style>"],"mappings":";AAoGA,OAAAA,KAAA;AACAA,KAAA,CAAAC,QAAA,CAAAC,eAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,QAAA;MACAC,QAAA;MACAC,OAAA;IACA;EACA;EACAC,OAAA;IACA,MAAAC,MAAA;MACA;QACA,MAAAC,QAAA,SAAAX,KAAA,CAAAY,IAAA;UACAN,QAAA,OAAAA,QAAA;UACAC,QAAA,OAAAA;QACA;UAAAL,eAAA;QAAA;QACA,KAAAM,OAAA,GAAAG,QAAA,CAAAN,IAAA,CAAAG,OAAA;QACA,IAAAG,QAAA,CAAAN,IAAA,CAAAQ,IAAA;UACAV,MAAA,CAAAW,IAAA;YAAAV,IAAA;UAAA;QACA;UACAD,MAAA,CAAAW,IAAA;YAAAV,IAAA;UAAA;QACA;MACA,SAAAW,KAAA;QACA,KAAAP,OAAA,GAAAO,KAAA,CAAAJ,QAAA,IAAAI,KAAA,CAAAJ,QAAA,CAAAN,IAAA,GAAAU,KAAA,CAAAJ,QAAA,CAAAN,IAAA,CAAAG,OAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}