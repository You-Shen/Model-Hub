{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nimport router from \"@/router\";\nexport default {\n  name: 'AdminFeedback',\n  data() {\n    return {\n      feedbacks: []\n    };\n  },\n  async created() {\n    await this.fetchFeedbacks();\n  },\n  methods: {\n    async fetchFeedbacks() {\n      try {\n        const response = await axios.get('/api/admin/feedback', {\n          withCredentials: true\n        });\n        this.feedbacks = response.data.feedbacks;\n      } catch (error) {\n        console.error('获取反馈信息时出错：', error);\n      }\n    },\n    goBack() {\n      router.push({\n        name: 'AdminDashboard'\n      });\n    }\n  }\n};","map":{"version":3,"names":["axios","router","name","data","feedbacks","created","fetchFeedbacks","methods","response","get","withCredentials","error","console","goBack","push"],"sources":["src/components/AdminFeedback.vue"],"sourcesContent":["<template>\r\n  <div class=\"admin-feedback-page bg-grid-pattern\">\r\n    <!-- 顶部导航栏 -->\r\n    <header class=\"bg-white/90 shadow-sm backdrop-blur-md sticky top-0 z-50\">\r\n      <div class=\"container mx-auto px-4 py-3 flex justify-between items-center\">\r\n        <div class=\"flex items-center space-x-2\">\r\n          <i class=\"fas fa-robot text-purple-600 text-xl\"></i>\r\n          <span class=\"font-bold text-gray-800 text-xl\">ModelHub <span class=\"gradient-text\">V2</span></span>\r\n          <span class=\"hidden md:inline text-sm text-gray-500 ml-2\">一站式大语言模型访问平台</span>\r\n        </div>\r\n        <button\r\n            @click=\"goBack\"\r\n            class=\"px-4 py-2 rounded-lg border-2 border-purple-600 text-purple-600 font-medium hover:bg-purple-50 transition-all duration-300\"\r\n        >\r\n          返回仪表板\r\n        </button>\r\n      </div>\r\n    </header>\r\n\r\n    <!-- 主内容区 - 调整了高度 -->\r\n    <main class=\"container mx-auto px-4 py-4\">\r\n      <div class=\"admin-content bg-white rounded-2xl shadow-xl p-6\" style=\"max-height: calc(100vh - 160px);\">\r\n        <div class=\"flex flex-col items-center mb-4\">\r\n          <i class=\"fas fa-comment-alt text-purple-600 text-3xl mb-2\"></i>\r\n          <h2 class=\"text-2xl font-bold text-gray-800\">用户反馈信息</h2>\r\n          <p class=\"text-gray-500 mt-1 text-sm\">查看用户提交的反馈和建议</p>\r\n        </div>\r\n\r\n        <div v-if=\"feedbacks.length > 0\" class=\"feedback-list flex-grow space-y-auto\" style=\"max-height: calc(100vh - 300px); overflow-y: auto;\">\r\n          <div\r\n              v-for=\"feedback in feedbacks\"\r\n              :key=\"feedback.id\"\r\n              class=\"feedback-card p-4 mb-3 rounded-lg border border-gray-200 hover:shadow-md transition-all duration-200 last:mb-0\"\r\n          >\r\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\r\n              <div>\r\n                <p class=\"text-xs text-gray-500\">反馈编号</p>\r\n                <p class=\"font-medium text-sm\">{{ feedback.id }}</p>\r\n              </div>\r\n              <div>\r\n                <p class=\"text-xs text-gray-500\">用户编号</p>\r\n                <p class=\"font-medium text-sm\">{{ feedback.user_id }}</p>\r\n              </div>\r\n              <div>\r\n                <p class=\"text-xs text-gray-500\">用户名</p>\r\n                <p class=\"font-medium text-sm\">{{ feedback.username }}</p>\r\n              </div>\r\n              <div>\r\n                <p class=\"text-xs text-gray-500\">提交时间</p>\r\n                <p class=\"font-medium text-sm\">{{ new Date(feedback.timestamp).toLocaleString() }}</p>\r\n              </div>\r\n            </div>\r\n            <div class=\"mt-3\">\r\n              <p class=\"text-xs text-gray-500\">反馈内容</p>\r\n              <p class=\"mt-1 p-2 bg-gray-50 rounded text-sm\">{{ feedback.message }}</p>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div v-else class=\"text-center py-8\">\r\n          <i class=\"fas fa-inbox text-gray-300 text-4xl mb-3\"></i>\r\n          <p class=\"text-gray-500 text-sm\">暂无用户反馈</p>\r\n        </div>\r\n      </div>\r\n    </main>\r\n\r\n    <!-- 页脚 -->\r\n    <footer class=\"footer bg-white/80 backdrop-blur-md mt-auto\">\r\n      <div class=\"container mx-auto px-4 py-4\">\r\n        <div class=\"text-center text-xs text-gray-500\">\r\n          ©2025 Created by HIT-ModelHub team. All rights reserved.\r\n        </div>\r\n      </div>\r\n    </footer>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\nimport router from \"@/router\";\r\n\r\nexport default {\r\n  name: 'AdminFeedback',\r\n  data() {\r\n    return {\r\n      feedbacks: []\r\n    };\r\n  },\r\n  async created() {\r\n    await this.fetchFeedbacks();\r\n  },\r\n  methods: {\r\n    async fetchFeedbacks() {\r\n      try {\r\n        const response = await axios.get('/api/admin/feedback', { withCredentials: true });\r\n        this.feedbacks = response.data.feedbacks;\r\n      } catch (error) {\r\n        console.error('获取反馈信息时出错：', error);\r\n      }\r\n    },\r\n    goBack() {\r\n      router.push({ name: 'AdminDashboard' });\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.admin-feedback-page {\r\n  min-height: 100vh;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.gradient-text {\r\n  background: linear-gradient(90deg, #8b5cf6 0%, #3b82f6 100%);\r\n  -webkit-background-clip: text;\r\n  background-clip: text;\r\n  color: transparent;\r\n}\r\n\r\n.bg-grid-pattern {\r\n  background-image:\r\n      linear-gradient(to right, rgba(0, 0, 0, 0.03) 1px, transparent 1px),\r\n      linear-gradient(to bottom, rgba(0, 0, 0, 0.03) 1px, transparent 1px);\r\n  background-size: 20px 20px;\r\n}\r\n\r\n/* 自定义滚动条 - 仅内部滚动 */\r\n.feedback-list::-webkit-scrollbar {\r\n  width: 4px;\r\n}\r\n\r\n.feedback-list::-webkit-scrollbar-track {\r\n  background: #f1f1f1;\r\n  border-radius: 4px;\r\n}\r\n\r\n.feedback-list::-webkit-scrollbar-thumb {\r\n  background: #c4c4c4;\r\n  border-radius: 4px;\r\n}\r\n\r\n.feedback-list::-webkit-scrollbar-thumb:hover {\r\n  background: #a0a0a0;\r\n}\r\n\r\n/* 确保Font Awesome图标正常显示 */\r\n@import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css');\r\n</style>"],"mappings":";AA6EA,OAAAA,KAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;IACA;EACA;EACA,MAAAC,QAAA;IACA,WAAAC,cAAA;EACA;EACAC,OAAA;IACA,MAAAD,eAAA;MACA;QACA,MAAAE,QAAA,SAAAR,KAAA,CAAAS,GAAA;UAAAC,eAAA;QAAA;QACA,KAAAN,SAAA,GAAAI,QAAA,CAAAL,IAAA,CAAAC,SAAA;MACA,SAAAO,KAAA;QACAC,OAAA,CAAAD,KAAA,eAAAA,KAAA;MACA;IACA;IACAE,OAAA;MACAZ,MAAA,CAAAa,IAAA;QAAAZ,IAAA;MAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}