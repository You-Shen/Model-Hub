{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\naxios.defaults.withCredentials = true;\nexport default {\n  name: 'RegisterComponent',\n  data() {\n    return {\n      username: '',\n      password: '',\n      message: ''\n    };\n  },\n  methods: {\n    async register() {\n      try {\n        const response = await axios.post('/api/register', {\n          username: this.username,\n          password: this.password\n        });\n        this.message = response.data.message;\n        if (response.status === 201) {\n          this.message += ' 2s后自动跳转到登录页面...';\n          setTimeout(() => {\n            this.$router.push('/login');\n          }, 2000);\n        }\n      } catch (error) {\n        this.message = error.response && error.response.data ? error.response.data.message : '注册失败，请稍后重试。';\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","defaults","withCredentials","name","data","username","password","message","methods","register","response","post","status","setTimeout","$router","push","error"],"sources":["src/components/Register.vue"],"sourcesContent":["<template>\n  <div>\n    <!-- 顶部导航栏 -->\n    <header class=\"bg-white/90 shadow-sm\">\n      <div class=\"container mx-auto px-4 py-3 flex justify-between items-center\">\n        <div class=\"flex items-center space-x-2\">\n          <i class=\"fas fa-robot text-purple-600 text-xl\"></i>\n          <span class=\"font-bold text-gray-800\">ModelHub <span class=\"text-purple-600\">V1</span></span>\n          <span class=\"hidden md:inline text-sm text-gray-500 ml-2\">一站式大语言模型访问平台</span>\n        </div>\n        <div class=\"flex items-center space-x-4\">\n          <a href=\"#\" class=\"text-gray-600 hover:text-purple-600 transition\">帮助中心</a>\n          <a href=\"#\" class=\"text-gray-600 hover:text-purple-600 transition\">关于我们</a>\n        </div>\n      </div>\n    </header>\n\n    <!-- 主内容区 -->\n    <main class=\"gradient-bg min-h-screen flex items-center justify-center p-4\">\n      <div class=\"login-card rounded-2xl overflow-hidden w-full max-w-md\">\n        <div class=\"p-8\">\n          <!-- 欢迎标题 -->\n          <div class=\"text-center mb-8\">\n            <h1 class=\"text-3xl font-bold text-gray-800 mb-2\">创建新账户</h1>\n            <p class=\"text-gray-500\">加入我们，开启AI体验之旅</p>\n          </div>\n\n          <!-- 注册表单 -->\n          <form @submit.prevent=\"register\" class=\"space-y-6\">\n            <!-- 用户名输入 -->\n            <div>\n              <label for=\"username\" class=\"block text-sm font-medium text-gray-700 mb-1\">用户名</label>\n              <div class=\"relative\">\n                <div class=\"absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none\">\n                  <i class=\"fas fa-user text-gray-400\"></i>\n                </div>\n                <input\n                    type=\"text\"\n                    id=\"username\"\n                    v-model=\"username\"\n                    placeholder=\"请输入用户名\"\n                    class=\"input-field pl-10 w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-purple-500 focus:outline-none transition\"\n                    required\n                >\n              </div>\n            </div>\n\n            <!-- 密码输入 -->\n            <div>\n              <label for=\"password\" class=\"block text-sm font-medium text-gray-700 mb-1\">密码</label>\n              <div class=\"relative\">\n                <div class=\"absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none\">\n                  <i class=\"fas fa-lock text-gray-400\"></i>\n                </div>\n                <input\n                    type=\"password\"\n                    id=\"password\"\n                    v-model=\"password\"\n                    placeholder=\"请输入密码\"\n                    class=\"input-field pl-10 w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-purple-500 focus:outline-none transition\"\n                    required\n                >\n              </div>\n            </div>\n\n            <!-- 注册按钮 -->\n            <button\n                type=\"submit\"\n                class=\"login-btn w-full bg-gradient-to-r from-purple-600 to-blue-500 text-white py-3 px-4 rounded-lg font-medium hover:from-purple-700 hover:to-blue-600 transition\"\n            >\n              立即注册\n            </button>\n\n            <!-- 错误消息 -->\n            <div v-if=\"message\" class=\"text-center py-2 px-4 rounded-md bg-red-100 text-red-700\">\n              {{ message }}\n            </div>\n          </form>\n\n          <!-- 登录链接 -->\n          <div class=\"mt-8 text-center text-sm text-gray-500\">\n            已有账号?\n            <router-link to=\"/login\" class=\"text-purple-600 font-medium hover:text-purple-800 transition\">立即登录</router-link>\n          </div>\n        </div>\n\n        <!-- 底部装饰 -->\n        <div class=\"bg-gray-50 px-8 py-4 text-center\">\n          <p class=\"text-xs text-gray-500\">© 2025 ModelHub V1. 保留所有权利。</p>\n        </div>\n      </div>\n    </main>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios';\naxios.defaults.withCredentials = true;\nexport default {\n  name: 'RegisterComponent',\n  data() {\n    return {\n      username: '',\n      password: '',\n      message: ''\n    };\n  },\n  methods: {\n    async register() {\n      try {\n        const response = await axios.post('/api/register', {\n          username: this.username,\n          password: this.password\n        });\n        this.message = response.data.message;\n        if (response.status === 201) {\n          this.message += ' 2s后自动跳转到登录页面...';\n          setTimeout(() => {\n            this.$router.push('/login');\n          }, 2000);\n        }\n      } catch (error) {\n        this.message = error.response && error.response.data ? error.response.data.message : '注册失败，请稍后重试。';\n      }\n    }\n  }\n};\n</script>\n\n<style scoped>\n.gradient-bg {\n  background: linear-gradient(135deg, #6e8efb 0%, #a777e3 100%);\n}\n.login-card {\n  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);\n  backdrop-filter: blur(10px);\n  background-color: rgba(255, 255, 255, 0.85);\n}\n.input-field:focus {\n  box-shadow: 0 0 0 3px rgba(167, 119, 227, 0.3);\n}\n.login-btn {\n  transition: all 0.3s ease;\n}\n.login-btn:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);\n}\n\n/* 确保Font Awesome图标正常显示 */\n@import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css');\n</style>"],"mappings":";AAgGA,OAAAA,KAAA;AACAA,KAAA,CAAAC,QAAA,CAAAC,eAAA;AACA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,QAAA;MACAC,QAAA;MACAC,OAAA;IACA;EACA;EACAC,OAAA;IACA,MAAAC,SAAA;MACA;QACA,MAAAC,QAAA,SAAAV,KAAA,CAAAW,IAAA;UACAN,QAAA,OAAAA,QAAA;UACAC,QAAA,OAAAA;QACA;QACA,KAAAC,OAAA,GAAAG,QAAA,CAAAN,IAAA,CAAAG,OAAA;QACA,IAAAG,QAAA,CAAAE,MAAA;UACA,KAAAL,OAAA;UACAM,UAAA;YACA,KAAAC,OAAA,CAAAC,IAAA;UACA;QACA;MACA,SAAAC,KAAA;QACA,KAAAT,OAAA,GAAAS,KAAA,CAAAN,QAAA,IAAAM,KAAA,CAAAN,QAAA,CAAAN,IAAA,GAAAY,KAAA,CAAAN,QAAA,CAAAN,IAAA,CAAAG,OAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}