{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\naxios.defaults.withCredentials = true;\nimport router from '@/router/index.js';\nexport default {\n  name: 'Login',\n  data() {\n    return {\n      username: '',\n      password: '',\n      message: ''\n    };\n  },\n  methods: {\n    async login() {\n      try {\n        const response = await axios.post('/api/login', {\n          username: this.username,\n          password: this.password\n        }, {\n          withCredentials: true\n        });\n        this.message = response.data.message;\n        if (response.data.role === 'admin') {\n          router.push({\n            name: 'AdminDashboard'\n          });\n        } else {\n          router.push({\n            name: 'UserDashboard'\n          });\n        }\n      } catch (error) {\n        this.message = error.response && error.response.data ? error.response.data.message : '登录失败，请稍后重试。';\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","defaults","withCredentials","router","name","data","username","password","message","methods","login","response","post","role","push","error"],"sources":["src/components/Login.vue"],"sourcesContent":["<!--<template>-->\n<!--  <div>-->\n<!--    &lt;!&ndash; 顶部栏 &ndash;&gt;-->\n<!--    <div class=\"top-bar\">-->\n<!--      <div class=\"left\">-->\n<!--        <span>ChatWithAIs V1 | 一站式大语言模型访问平台</span>-->\n<!--      </div>-->\n<!--    </div>-->\n\n<!--    <div class=\"login-page\">-->\n<!--      <div class=\"login-container\">-->\n<!--        <h2 class=\"login-title\">欢迎回来！</h2>-->\n<!--        <form @submit.prevent=\"login\" class=\"login-form\">-->\n<!--          <div class=\"form-group\">-->\n<!--            <label for=\"username\">用户名：</label>-->\n<!--            <input type=\"text\" v-model=\"username\" class=\"input-field\" required>-->\n<!--          </div>-->\n<!--          <div class=\"form-group\">-->\n<!--            <label for=\"password\">密码：</label>-->\n<!